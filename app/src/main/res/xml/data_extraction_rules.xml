<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      A stopwatch reading is tied to the device it was started on: its uptime reference means
      nothing anywhere else. Leave it out of backup and transfer rather than restoring a
      measurement that can only be discarded.
    -->
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore" />
    </device-transfer>
</data-extraction-rules>
